# Postgres. Neon, Supabase and Railway all work; any Postgres 14+ does.
DATABASE_URL="postgresql://user:password@host:5432/alfmaskan?schema=public"

# The apex the free storefront addresses hang off: <slug>.alfmaskan.com
NEXT_PUBLIC_ROOT_DOMAIN="alfmaskan.com"

# Where the dashboard itself lives, so middleware can tell app from storefront.
NEXT_PUBLIC_APP_HOST="app.alfmaskan.com"

# Paymob — card, wallet and Fawry all settle through one integration.
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""

# S3-compatible object storage for unit photos. R2 has no egress fee, which
# matters for a product whose whole job is serving property photography.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
